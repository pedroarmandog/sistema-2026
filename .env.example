# =============================================
# MODELO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com
# os valores reais. NUNCA commitar o .env real.
# =============================================

# --- Banco de dados (produção / Hostinger) ---
DB_HOST=seu-host.hstgr.io
DB_USER=seu_usuario_db
DB_PASSWORD=sua_senha_db
DB_NAME=seu_banco_db
DATABASE_URL=mysql://usuario:senha@host:3306/banco

# --- JWT ---
# Chave para autenticação do painel admin
JWT_SECRET=troque-por-uma-chave-segura-longa
# Chave para tokens dos usuários do sistema
JWT_USER_SECRET=troque-por-outra-chave-segura-longa
# Token de acesso à página de cadastro de admin
CADASTRO_TOKEN=troque-por-token-aleatorio

# --- Seed inicial ---
# Senha do admin criado na primeira execução (será hasheada)
ADMIN_SEED_PASSWORD=troque-por-senha-forte

# --- Banco LOCAL (scripts de migração / desenvolvimento) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=sua_senha_root_local
LOCAL_DB_NAME=petshop

# --- Push Notifications (Web Push) ---
# Gere chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=sua_chave_publica_aqui
VAPID_PRIVATE_KEY=sua_chave_privada_aqui
VAPID_SUBJECT=mailto:contato@pethubflow.com.br

# --- Puppeteer ---
PUPPETEER_SKIP_DOWNLOAD=true
